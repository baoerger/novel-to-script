# LLM Provider 选择 (deepseek / qwen)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=qwen3.7-plus
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0

# AI 引擎 API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# 应用配置 (可选, 有默认值)
# PROJECTS_DIR=./projects
# MAX_CHAPTERS=100
# MAX_TOKENS_PER_CHAPTER=15000
